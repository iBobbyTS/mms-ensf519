{
	"name": "mms-ensf519",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations",
		"db:reset:local": "wrangler d1 execute DB --local --file=./schema.sql --persist-to .wrangler/state",
		"db:seed": "node --experimental-strip-types scripts/seed.ts",
		"clean:dev-output": "rm -rf .svelte-kit/output .svelte-kit/cloudflare .svelte-kit/cloudflare-tmp",
		"dev": "bun run i18n:compile && bun run clean:dev-output && vite dev --host 0.0.0.0 --port 8787",
		"dev:reset": "bun run db:reset:local && bun run db:seed && bun run dev",
		"build": "bun run clean:dev-output && bun run i18n:compile && vite build",
		"preview": "bun run i18n:compile && vite preview --host 0.0.0.0 --port 8787",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "bun run i18n:compile && node --test --experimental-strip-types src/lib/*.test.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260317.1",
		"@inlang/paraglide-js": "2.15.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.5.0",
		"daisyui": "^5.5.19",
		"lucide-svelte": "^0.577.0",
		"svelte": "^5.54.1",
		"svelte-check": "^4.4.5",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^8.0.1",
		"wrangler": "4.107.0"
	},
	"dependencies": {
		"@ibobbyts/svelte-ui-utils": "0.4.7",
		"@inlang/paraglide-sveltekit": "0.16.1",
		"@pinyin-pro/data": "^1.3.1",
		"drizzle-orm": "^0.45.2",
		"html5-qrcode": "^2.3.8",
		"opencc-js": "1.3.1",
		"pinyin-pro": "^3.28.1",
		"string.prototype.replaceall": "1.0.11"
	}
}
